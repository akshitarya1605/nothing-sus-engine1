// Nothing Sus — Game Engine schema
//
// Design notes (see docs/GAME_ENGINE.md for the full write-up):
// - Postgres is the single source of truth. No game rule is enforced by
//   trusting a value the client sent; every mutation goes through
//   lib/game/* which re-derives/validates state from this database.
// - Realtime fan-out rides on Postgres NOTIFY, triggered from the same
//   transaction that writes a GameEvent row (see lib/game/events). The
//   Supabase Realtime "Postgres Changes" path (Milestone 1) runs alongside
//   it, authorized by the RLS policies below.
// - Role privacy and vote privacy are enforced primarily in the query
//   layer (lib/game/state + API route guards). As of Milestone 1 there is
//   also a row-level RLS backstop (see prisma/migrations/*_rls_*): it scopes
//   reads to the caller's own game/audience when a request goes through
//   lib/db/rlsContext.ts, and it authorizes what Supabase Realtime forwards.
//   RLS is row-level only — column privacy (Participant.role, Task.otpHash)
//   stays a query-layer job. See docs/SECURITY.md for the full rationale.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and
// is passed via a driver adapter to the PrismaClient constructor (for the
// app) — see lib/db/prisma.ts. Nothing here reads DATABASE_URL directly.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Game + configuration
// ---------------------------------------------------------------------

enum GameStatus {
  SETUP
  READY
  LIVE
  MEETING
  VOTING
  REVEAL
  PAUSED
  ROUND_COMPLETE
  FINISHED
}

enum RoundPhase {
  ROUND
  MEETING
  VOTING
  REVEAL
}

model Game {
  id     String     @id @default(cuid())
  name   String
  status GameStatus @default(SETUP)

  currentRoundNumber Int         @default(0)
  currentPhase       RoundPhase?

  // set when status = PAUSED, so we know what to resume into
  pausedFromStatus GameStatus?
  pausedAt         DateTime?
  pauseReason      String?

  rolesLocked   Boolean   @default(false)
  rolesLockedAt DateTime?

  /// Long random tokens for the secret admin/spectator URLs
  /// (/control/<adminSecret>, /spectator/<spectatorSecret>). Generated
  /// with crypto.randomBytes at game creation — never a Prisma @default,
  /// since these need real entropy, not a cuid. Never returned in any
  /// participant-facing response. See docs/SECURITY.md.
  adminSecret     String @unique
  spectatorSecret String @unique

  roomCode   String? @unique
  maxPlayers Int     @default(30)
  presetId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config            GameConfig?
  result            GameResult?
  rounds            Round[]
  participants      Participant[]
  groups            Group[]
  locations         Location[]
  tasks             Task[]
  meetings          Meeting[]
  eliminations      Elimination[]
  abilities         Ability[]
  events            GameEvent[]
  auditLogs         AuditLog[]
  adminSessions     AdminSession[]
  spectatorSessions SpectatorSession[]
}

/// Configurable rules. Never scatter these as magic numbers in code —
/// every place that needs one of these reads it from here.
model GameConfig {
  id     String @id @default(cuid())
  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  totalRounds              Int     @default(4)
  meetingAfterMinutes      Int     @default(20)
  imposterCount            Int     @default(0)
  allowEmergencyMeeting    Boolean @default(true)
  revealRoleAfterVote      Boolean @default(true)
  allowImposterElimination Boolean @default(true)

  /// "ENGINEERS_COMPLETE_TASKS" | "IMPOSTERS_REMAIN" | "FINAL_ROUND_RESULT"
  engineerWinCondition String @default("ENGINEERS_COMPLETE_TASKS")
  imposterWinCondition String @default("IMPOSTERS_REMAIN")

  /// "NO_ELIMINATION" | "ADMIN_DECISION"
  voteTiePolicy String @default("NO_ELIMINATION")

  /// max OTP attempts per participant per task within otpRateLimitWindowSeconds
  otpRateLimitMax           Int @default(10)
  otpRateLimitWindowSeconds Int @default(60)

  killCooldownSeconds Int     @default(60)
  weaponLocation      String?
  weaponClue          String?
  weaponQrCode        String? @default("WEAPON-SUS-2026")

  updatedAt DateTime @updatedAt
}

enum GameWinner {
  ENGINEERS
  IMPOSTERS
  NONE
}

model GameResult {
  id     String @id @default(cuid())
  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  winner                 GameWinner
  reason                 String
  topScorerParticipantId String?
  runnerUpParticipantId  String?
  stats                  Json

  /// true when the host declared the outcome rather than the engine
  /// computing it from the win conditions
  declaredByHost Boolean @default(false)
  /// optional single player the host spotlighted as the winner
  championParticipantId String?

  finishedAt DateTime @default(now())
}

// ---------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  ACTIVE
  MEETING
  VOTING
  REVEAL
  COMPLETE
}

model Round {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  number Int
  name   String

  scheduledStartAt DateTime
  durationMinutes  Int

  /// null until the round is actually (re)started by the engine
  startedAt DateTime?
  endedAt   DateTime?

  /// per-round override; falls back to GameConfig.meetingAfterMinutes
  meetingAfterMinutes Int?

  status RoundStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks    Task[]
  meetings Meeting[]

  @@unique([gameId, number])
  @@index([gameId, status])
}

// ---------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------

model Group {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  participants Participant[]
  tasks        Task[]

  @@unique([gameId, name])
  @@index([gameId])
}

// ---------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------

model Location {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  name        String
  floor       String?
  building    String?
  description String?
  forImposter Boolean @default(false)

  active      Boolean @default(true)

  /// opaque token used in the QR payload (/location/scan/<qrToken>) —
  /// never the row id, so a photographed QR code can't be used to
  /// enumerate/guess other location ids.
  qrToken String @unique @default(cuid())

  createdAt DateTime @default(now())

  tasks          Task[]
  participants   Participant[]   @relation("ParticipantCurrentLocation")
  locationEvents LocationEvent[]

  @@index([gameId])
}

enum LocationEventType {
  ENTERED
  EXITED
}

model LocationEvent {
  id            String            @id @default(cuid())
  gameId        String
  participantId String
  locationId    String
  type          LocationEventType

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
  @@index([participantId])
}

// ---------------------------------------------------------------------
// Participants + roles
// ---------------------------------------------------------------------

enum ParticipantStatus {
  ALIVE
  ELIMINATED
  SPECTATOR
  /// removed by the host (cheating, left early). Excluded from win-condition
  /// counts, which only look at ALIVE.
  DISQUALIFIED
}

enum ParticipantRole {
  ENGINEER
  IMPOSTER
}

model StudentAccount {
  id             String    @id @default(cuid())
  fullName       String
  collegeRegId   String    @unique
  passwordHash   String
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  participations Participant[]
  sessions       StudentSession[]

  @@index([approvalStatus])
}

model StudentSession {
  id        String         @id @default(cuid())
  accountId String
  account   StudentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([accountId, revokedAt])
}

model Participant {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  accountId String?
  account   StudentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// the one-code login credential, e.g. "NS-7K4P92" — globally unique
  /// (not just per-game) so login needs only the code, nothing else.
  code String @unique
  name String

  collegeRegId String?
  fullName     String?
  isApproved   Boolean   @default(false)
  approvedAt   DateTime?

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  /// null until roles are assigned server-side
  role   ParticipantRole?
  status ParticipantStatus @default(ALIVE)

  playerNumber   Int?
  badge          String?
  batchNumber    Int       @default(1)
  lastKillAt     DateTime?
  weaponUnlocked Boolean   @default(false)

  currentRoundNumber Int?
  currentLocationId  String?
  currentLocation    Location? @relation("ParticipantCurrentLocation", fields: [currentLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         ParticipantSession[]
  participantTasks ParticipantTask[]
  taskAttempts     TaskAttempt[]
  votesCast        Vote[]               @relation("VoterVotes")
  votesReceived    Vote[]               @relation("TargetVotes")
  eliminations     Elimination[]
  locationEvents   LocationEvent[]
  abilityUses      AbilityUse[]
  meetingsCalled   Meeting[]            @relation("MeetingCalledByParticipant")
  chatMessages     ChatMessage[]

  @@index([gameId, status])
  @@index([gameId, role])
  @@index([gameId, badge])
  @@index([groupId])
}

/// One row per currently-or-previously active device session for a
/// participant. Login enforces "one active device at a time" by
/// checking for a row here with revokedAt = null and expiresAt in the
/// future before allowing a new one — see docs/SECURITY.md "Single
/// device session".
model ParticipantSession {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// sha256 of the session token — the raw token only ever exists in
  /// the httpOnly cookie and the moment it's generated server-side.
  sessionTokenHash String @unique

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String? // "ADMIN" | "RELOGIN" | null

  @@index([participantId, revokedAt])
}

/// Exchanged for an httpOnly admin cookie the moment /control/<secret>
/// is visited — the secret itself is never stored client-side again
/// after that. See docs/SECURITY.md "Admin access".
model AdminSession {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([gameId, revokedAt])
}

model SpectatorSession {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([gameId, revokedAt])
}

// ---------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

/// Global availability toggle for the task definition itself — NOT a
/// participant's personal progress (see ParticipantTask for that).
enum TaskStatus {
  LOCKED
  AVAILABLE
  DISABLED
}

model Task {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// set to restrict/auto-assign this task to one group; null = open to
  /// whichever participants an admin explicitly assigns individually
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  title       String
  description String
  forImposter Boolean @default(false)


  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  difficulty       TaskDifficulty
  estimatedMinutes Int
  points           Int
  
  requiresPhoto    Boolean @default(false)
  requiresAnswer   Boolean @default(false)

  status TaskStatus @default(LOCKED)

  availableFrom  DateTime?
  availableUntil DateTime?

  /// sha256(otp) — the plaintext 4-digit code is never stored. Given a
  /// 4-digit space is small, the OTP rate limit (GameConfig.otpRateLimitMax
  /// per otpRateLimitWindowSeconds, enforced via TaskAttempt) is the real
  /// defense, not the hash — but we still never persist or transmit the
  /// plaintext value once generated, per the brief.
  otpHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participantTasks ParticipantTask[]
  taskAttempts     TaskAttempt[]

  @@index([gameId, roundId, status])
  @@index([groupId])
}

enum ParticipantTaskStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

/// A task DEFINITION is global; a PARTICIPANT's completion of it is
/// personal. Completing a task never mutates Task.status — only this row.
model ParticipantTask {
  id            String @id @default(cuid())
  participantId String
  taskId        String

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  status        ParticipantTaskStatus @default(LOCKED)
  startedAt     DateTime?
  completedAt   DateTime?
  score         Int?
  attemptCount  Int                   @default(0)
  lastAttemptAt DateTime?

  verificationData Json?

  @@unique([participantId, taskId])
  @@index([taskId, status])
}

/// Every OTP attempt (right or wrong) — the audit trail behind the rate
/// limit and behind "average completion time" / "attempt count" admin
/// analytics. Never stores the entered OTP itself, just whether it
/// matched.
model TaskAttempt {
  id            String  @id @default(cuid())
  participantId String
  taskId        String
  wasCorrect    Boolean

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([participantId, taskId, createdAt])
}

// ---------------------------------------------------------------------
// Meetings + chat + voting
// ---------------------------------------------------------------------

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  VOTING
  CLOSED
  REVEALED
}

enum MeetingType {
  SCHEDULED
  AUTOMATIC
  ADMIN_CALLED
  EMERGENCY
}

model Meeting {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  status MeetingStatus @default(SCHEDULED)
  type   MeetingType

  startedAt       DateTime?
  votingStartedAt DateTime?
  votingEndedAt   DateTime?
  endedAt         DateTime?
  reason          String?

  calledById String?
  calledBy   Participant? @relation("MeetingCalledByParticipant", fields: [calledById], references: [id])

  createdAt DateTime @default(now())

  votes        Vote[]
  eliminations Elimination[]
  chatMessages ChatMessage[]

  @@index([gameId, roundId])
  @@index([gameId, status])
}

/// Chat is scoped to a meeting (discussion + voting window). Alive
/// participants only — see lib/game/actions/chat.ts. Never shown to the
/// projector (spec: "Projector does NOT display chat").
model ChatMessage {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  senderId String
  sender   Participant @relation(fields: [senderId], references: [id], onDelete: Cascade)

  /// plain text only — sanitized/stripped of markup before storage, see
  /// lib/game/actions/chat.ts. Never rendered as raw HTML on any client.
  message String

  isGhost   Boolean   @default(false)
  deletedAt DateTime? // admin moderation — soft delete, not a hard delete

  createdAt DateTime @default(now())

  @@index([meetingId, createdAt])
}

model Vote {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  voterId String
  voter   Participant @relation("VoterVotes", fields: [voterId], references: [id], onDelete: Cascade)

  /// null = explicit "skip vote"
  targetParticipantId String?
  target              Participant? @relation("TargetVotes", fields: [targetParticipantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([meetingId, voterId])
  @@index([meetingId])
}

enum EliminationMethod {
  VOTE
  ADMIN
  ABILITY
  DISQUALIFIED
}

enum RoleRevealStatus {
  PENDING
  REVEALED
}

model Elimination {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id])

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  method EliminationMethod

  roleRevealStatus RoleRevealStatus @default(PENDING)
  revealedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([gameId])
  @@index([participantId])
}

// ---------------------------------------------------------------------
// Imposter abilities (architecture only — disabled until rules are final)
// ---------------------------------------------------------------------

enum AbilityKey {
  SABOTAGE
  ROOM_LOCK
  TASK_DISRUPTION
  ELIMINATION
}

model Ability {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  key             AbilityKey
  cooldownSeconds Int
  durationSeconds Int
  availableRound  Int?
  enabled         Boolean    @default(false)

  uses AbilityUse[]

  @@unique([gameId, key])
}

model AbilityUse {
  id        String  @id @default(cuid())
  abilityId String
  ability   Ability @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  targetId String?
  metadata Json?

  usedAt DateTime @default(now())

  @@index([abilityId, participantId])
}

// ---------------------------------------------------------------------
// Realtime events + audit log
// ---------------------------------------------------------------------

/// PUBLIC: safe for every connected client (participants, spectator).
/// ADMIN: admin console only.
/// PROJECTOR: spectator console only (may include reveal-gated data the
///   public channel doesn't get, but never raw role tables or chat).
/// PARTICIPANT: only the participant named in targetParticipantId (their
///   own role, their own task state, etc).
enum EventVisibility {
  PUBLIC
  ADMIN
  PROJECTOR
  PARTICIPANT
  /// all participants of the game + admin (moderation) — never the
  /// projector/spectator. Used for chat only.
  MEETING
}

/// The realtime + announcement feed. Every important thing that happens
/// in the game is a row here first; realtime delivery (Postgres NOTIFY)
/// is a side effect of the same transaction that inserts the row, and a
/// client that reconnects can always replay from `sequenceNumber` to
/// reconcile — realtime is a delivery mechanism, not the source of truth.
model GameEvent {
  id             String @id @default(cuid())
  gameId         String
  game           Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sequenceNumber BigInt @default(autoincrement())

  type       String
  visibility EventVisibility

  /// required when visibility = PARTICIPANT
  targetParticipantId String?

  payload Json

  createdAt DateTime @default(now())

  @@index([gameId, sequenceNumber])
  @@index([gameId, visibility, createdAt])
  @@index([gameId, targetParticipantId])
}

enum ActorType {
  ADMIN
  SYSTEM
  PARTICIPANT
}

model AuditLog {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  actorType ActorType
  actorId   String?

  action     String
  targetType String?
  targetId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
  @@index([gameId, action])
}

/// Fixed-window rate limiting for unauthenticated endpoints (participant
/// login, secret-link exchange). One row per hit; the limiter prunes rows
/// older than the window. Not on the realtime publication, no RLS.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------
// Game Presets & Reusable Task Templates
// ---------------------------------------------------------------------

model GamePreset {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  maxPlayers              Int      @default(30)
  imposterCount           Int      @default(3)
  killCooldownSeconds     Int      @default(60)
  weaponLocation          String?
  weaponClue              String?
  weaponQrCode            String?  @default("WEAPON-SUS-2026")
  allowEmergencyMeeting   Boolean  @default(true)
  totalRounds             Int      @default(4)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tasks PresetTask[]
}

model PresetTask {
  id               String         @id @default(cuid())
  presetId         String
  preset           GamePreset     @relation(fields: [presetId], references: [id], onDelete: Cascade)
  title            String
  description      String
  roomName         String?
  difficulty       TaskDifficulty @default(EASY)
  points           Int            @default(10)
  estimatedMinutes Int            @default(5)
  roundNumber      Int            @default(1)

  @@index([presetId])
}
