# Nothing Sus — Game Engine environment variables
#
# Copy to .env for local development. Never commit .env — see .gitignore.

# --- Database --------------------------------------------------------------
# Local dev: the Supabase Postgres from `npx supabase start`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
#
# Hosted (Vercel + Supabase): point DATABASE_URL at the *pooled* connection
# (Supabase dashboard -> Connect -> "Transaction pooler", port 6543) with
# `?pgbouncer=true&connection_limit=1`, and set DIRECT_URL to the direct
# connection (port 5432) — Prisma migrations need a non-pooled connection.
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# --- Deploy ----------------------------------------------------------------
# Absolute origin of the deployed app — used for OG metadata and the join
# QR codes. Set to the Vercel/prod URL in that environment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
#
# Shared secret for the /api/game/tick cron (Vercel sends it as a Bearer
# token). Generate: `openssl rand -hex 32`. Leave unset locally to allow.
# CRON_SECRET=""

# --- Auth --------------------------------------------------------------
# Symmetric key used by the session layer. Generate a real one for
# production: `openssl rand -base64 32`
AUTH_SECRET="dev-only-insecure-secret-change-me"

# Shared passphrase admins use to obtain an admin session.
# There is no per-admin user table yet — see docs/SECURITY.md "Known
# limitations". Anyone with this passphrase has full admin authority.
ADMIN_PASSPHRASE="change-me-admin"

# Shared passphrase for projector/spectator clients (read-only, no game
# mutation capability regardless of what it's paired with).
PROJECTOR_PASSPHRASE="change-me-projector"

# --- Supabase ----------------------------------------------------------
# Local values are from `npx supabase status`. For a hosted project, use the
# project's API URL, anon key, and JWT secret from the Supabase dashboard,
# and set these as Vercel environment variables (never commit real ones).
#
# URL + anon key are used by the browser Realtime client, so they are
# NEXT_PUBLIC_. Neither is a secret — RLS + the short-lived token from
# /api/realtime/token are what scope a subscription.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
#
# SUPABASE_JWT_SECRET (SERVER ONLY — never NEXT_PUBLIC_) signs the
# short-lived (~5 min) tokens the browser uses to authenticate its Realtime
# subscription. Nothing else uses it; the login/session system is unchanged.
#
# !!! The value below is the well-known local default shipped by the Supabase
# !!! CLI. It is PUBLIC, not a secret. Use the hosted project's real secret
# !!! (Supabase dashboard -> Project Settings -> API -> JWT Settings) for any
# !!! deployed environment — otherwise anyone can mint valid Realtime tokens.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
